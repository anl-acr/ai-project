{
  "info": {
    "name": "Nornia Enterprise PBX API (v3.10.11)",
    "description": "Nornia Enterprise AI PBX Kurumsal Dış API v1 Postman Koleksiyonu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://musteri.nornia.com.tr"
    },
    {
      "key": "api_key",
      "value": "aida_live_default_BURAYA_ANAHTARINIZI_YAZIN"
    }
  ],
  "item": [
    {
      "name": "1. Canlı Çağrı & Santral Kontrolü (Click-to-Call / Transfer / Hangup)",
      "item": [
        {
          "name": "Tıkla-Ara (Click-to-Call) Çağrı Başlatma",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/calls/originate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "originate"
              ]
            },
            "description": "Önce temsilcinin dahili telefonunu (WebPhone / Masa Telefonu / Mobil) çaldırır; temsilci açtığında otomatik olarak hedef müşteri numarasını arar ve iki tarafı bağlar.\n\nGerekli Yetki (Scope): `calls:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extension\": \"1000\",\n  \"destination\": \"05321234567\",\n  \"caller_id\": \"908503607390\",\n  \"timeout\": 30\n}"
            }
          }
        },
        {
          "name": "Aktif (Canlı) Çağrıları Listeleme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/calls/active",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "active"
              ]
            },
            "description": "Santral üzerinde o an konuşulan veya çalmakta olan tüm canlı çağrıları ve kanal bilgilerini döndürür.\n\nGerekli Yetki (Scope): `calls:read`"
          }
        },
        {
          "name": "Canlı Çağrıyı Başka Dahiliye veya Kuyruğa Aktarma (Transfer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/calls/aida-1763890123-4918/transfer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "{call_id}",
                "transfer"
              ]
            },
            "description": "Devam eden bir görüşmeyi belirtilen dahili numaraya (örn. 1002), kuyruğa (örn. 2000) veya dış numaraya aktarır.\n\nGerekli Yetki (Scope): `calls:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_extension\": \"1002\",\n  \"context\": \"webrtc_agents\"\n}"
            }
          }
        },
        {
          "name": "Aktif Çağrıyı Sonlandırma (Hangup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/calls/aida-1763890123-4918/hangup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "{call_id}",
                "hangup"
              ]
            },
            "description": "Belirtilen çağrı kimliğine (call_id) veya kanala ait aktif görüşmeyi sonlandırır.\n\nGerekli Yetki (Scope): `calls:write`",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Canlı Çağrıda Ses Kaydını Duraklatma / Devam Ettirme (KVKK & Kredi Kartı Maskeleme)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/calls/aida-1763890123-4918/recording-pause",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "{call_id}",
                "recording-pause"
              ]
            },
            "description": "Görüşme esnasında müşteri kredi kartı veya KVKK hassas bilgisi söylerken ses kaydını (MixMonitor) duraklatır (`paused: true`) ve işlem bitince tekrar başlatır (`paused: false`).\n\nGerekli Yetki (Scope): `calls:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extension\": \"1000\",\n  \"paused\": true\n}"
            }
          }
        },
        {
          "name": "Canlı Çağrıyı Beklemeye Alma / Beklemeden Çıkarma (Hold / Unhold)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/calls/aida-1763890123-4918/hold",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "{call_id}",
                "hold"
              ]
            },
            "description": "Aktif görüşmedeki müşteriyi bekleme müziğine (MoH) alır (`hold: true`) veya beklemeden çıkarıp görüşmeye geri döndürür (`hold: false`).\n\nGerekli Yetki (Scope): `calls:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extension\": \"1000\",\n  \"hold\": true\n}"
            }
          }
        },
        {
          "name": "Süpervizör Canlı Çağrı Dinleme, Fısıldama (Whisper) ve Araya Girme (Barge-In)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/calls/monitor",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "monitor"
              ]
            },
            "description": "Yöneticinin (`supervisor_extension`) seçilen temsilcinin (`target_extension`) aktif görüşmesini sessiz dinlemesini (`listen`), sadece temsilciye sufle vermesini (`whisper`) veya konferans olarak araya girmesini (`barge`) başlatır.\n\nGerekli Yetki (Scope): `calls:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supervisor_extension\": \"1000\",\n  \"target_extension\": \"1001\",\n  \"mode\": \"whisper\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Çağrı Raporları (CDR), Ses Kayıtları & Transkript",
      "item": [
        {
          "name": "Detaylı Çağrı Geçmişi (CDR) ve Transfer/Pickup Zinciri Sorgulama",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/cdr?limit=50&direction=inbound",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "cdr"
              ]
            },
            "description": "Tarih aralığı, yön (inbound/outbound), arayan numara, dahili abone ve durum filtreleriyle tüm çağrı kayıtlarını, ses kaydı URL'lerini ve transfer bacaklarını (call_legs) döndürür.\n\nGerekli Yetki (Scope): `cdr:read`"
          }
        },
        {
          "name": "Tekil Çağrı Detayı, Ses Kaydı Bağlantıları & Konuşma Dökümü (Transcript)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/cdr/aida-1763890123-4918",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "cdr",
                "{call_id}"
              ]
            },
            "description": "Belirtilen çağrının tüm bacaklarını, duygu analizini, AI özetini, konuşma metnini (transkript) ve ses kaydı indirme bağlantılarını getirir.\n\nGerekli Yetki (Scope): `cdr:read`"
          }
        },
        {
          "name": "Çağrı Ses Kaydı Dosyasını (WAV / MP3) İndirme veya Dinleme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/cdr/aida-1763890123-4918/recording",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "cdr",
                "{call_id}",
                "recording"
              ]
            },
            "description": "Çağrının tam ses kaydını veya `leg_index` parametresiyle sadece belirli bir transfer görüşmesinin ses kaydını stream olarak indirir.\n\nGerekli Yetki (Scope): `cdr:read`"
          }
        }
      ]
    },
    {
      "name": "3. Dahili Aboneler (Kullanıcılar) & Temsilci Mola Yönetimi",
      "item": [
        {
          "name": "Tüm Dahili Aboneleri ve Anlık Durumlarını Listeleme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/extensions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "extensions"
              ]
            },
            "description": "Sistemdeki tüm kullanıcıları, dahili numaralarını, çevrimiçi IP durumlarını, ses kaydı ve çağrı yönlendirme ayarlarını listeler.\n\nGerekli Yetki (Scope): `extensions:read`"
          }
        },
        {
          "name": "Yeni Dahili Abone (Kullanıcı) Oluşturma",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/extensions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "extensions"
              ]
            },
            "description": "Santrale yeni bir dahili numara ve kullanıcı ekler, Asterisk PJSIP yapılandırmasını otomatik senkronize eder.\n\nGerekli Yetki (Scope): `extensions:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ahmet.yilmaz\",\n  \"full_name\": \"Ahmet Yılmaz\",\n  \"extension\": \"1025\",\n  \"email\": \"ahmet@sirket.com\",\n  \"role\": \"agent\",\n  \"recording_active\": true\n}"
            }
          }
        },
        {
          "name": "Dahili Abone Ayarlarını Güncelleme (Ses Kaydı, Yönlendirme, Dış Arama)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/extensions/1000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "extensions",
                "{extension}"
              ]
            },
            "description": "Mevcut bir abonenin ses kayıt durumunu, çağrı yönlendirmelerini (Her Zaman / Meşgul / Cevapsız), CallerID veya aktiflik durumunu günceller.\n\nGerekli Yetki (Scope): `extensions:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recording_active\": false,\n  \"outbound_caller_id\": \"908503607390\",\n  \"forwarding_no_answer\": {\n    \"active\": true,\n    \"type\": \"external\",\n    \"target\": \"05321234567\",\n    \"timeout\": 25\n  }\n}"
            }
          }
        },
        {
          "name": "Temsilci Durumunu Değiştirme (Müsait / Molaya Çıkar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/extensions/1000/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "extensions",
                "{extension}",
                "status"
              ]
            },
            "description": "Temsilciyi dış sistemden (CRM/WFM) Müsait (available) duruma geçirir veya belirtilen mola türüyle molaya (break) çıkarır.\n\nGerekli Yetki (Scope): `extensions:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"break\",\n  \"break_reason\": \"Yemek Molası\"\n}"
            }
          }
        },
        {
          "name": "Dahili Aboneyi Silme",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/extensions/1000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "extensions",
                "{extension}"
              ]
            },
            "description": "Belirtilen dahili aboneyi santralden ve PJSIP yapılandırmasından kaldırır.\n\nGerekli Yetki (Scope): `extensions:delete`"
          }
        }
      ]
    },
    {
      "name": "4. ACD Arama Kuyrukları & Abone Grupları",
      "item": [
        {
          "name": "ACD Çağrı Kuyruklarını ve Üyelerini Listeleme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/queues",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "queues"
              ]
            },
            "description": "Tüm çağrı kuyruklarını, çalma stratejilerini, RONA/anket ayarlarını ve kuyruktaki dahili temsilcileri listeler.\n\nGerekli Yetki (Scope): `queues:read`"
          }
        },
        {
          "name": "Yeni ACD Çağrı Kuyruğu Oluşturma",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/queues",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "queues"
              ]
            },
            "description": "Yeni bir çağrı kuyruğu oluşturur ve Asterisk queues.conf dosyasını otomatik günceller.\n\nGerekli Yetki (Scope): `queues:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"VIP Destek Kuyruğu\",\n  \"extension\": \"2050\",\n  \"strategy\": \"rrmemory\",\n  \"timeout\": 20,\n  \"wrapup_time\": 10,\n  \"members\": [\n    \"1000\",\n    \"1001\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Kuyruk Ayarlarını veya Temsilcilerini Güncelleme",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/queues/6000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "queues",
                "{queue_id}"
              ]
            },
            "description": "Kuyruğun çalma stratejisini, bekleme sürelerini, anonslarını günceller veya kuyruğa temsilci ekler/çıkarır.\n\nGerekli Yetki (Scope): `queues:write`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy\": \"leastrecent\",\n  \"timeout\": 25,\n  \"member_action\": \"add\",\n  \"member_extensions\": [\n    \"1005\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Abone Gruplarını Listeleme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/subscriber-groups",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "subscriber-groups"
              ]
            },
            "description": "Santraldeki tüm abone gruplarını, grup üyelerini ve atanmış giden arama kurallarını döndürür.\n\nGerekli Yetki (Scope): `queues:read`"
          }
        }
      ]
    },
    {
      "name": "5. Gelen / Giden Arama Kuralları, SIP Trunk & Toplu Konfigürasyon",
      "item": [
        {
          "name": "Gelen Arama (DID) Yönlendirme Kurallarını Listeleme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/inbound-rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "inbound-rules"
              ]
            },
            "description": "Dış hat numaralarına (DID) gelen çağrıların hangi kuyruk, dahili veya AI asistana yönlendirildiğini listeler.\n\nGerekli Yetki (Scope): `routing:read`"
          }
        },
        {
          "name": "Giden Arama Kurallarını Listeleme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/outbound-rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "outbound-rules"
              ]
            },
            "description": "Giden arama kurallarını, önekleri (prefix), kullanılan SIP Trunk ve PIN politikalarını listeler.\n\nGerekli Yetki (Scope): `routing:read`"
          }
        },
        {
          "name": "Dış Hatları (SIP Trunks) ve Kayıt Durumlarını Listeleme",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
