{
  "name": "aida-agent-desktop",
  "version": "2.9.3",
  "description": "AIDA Agent — macOS & Windows Çağrı Merkezi Temsilci Masaüstü Uygulaması",
  "main": "src/main.js",
  "author": "AIDA Communication Systems",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:all": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -mw"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aida.agent.desktop",
    "productName": "AIDA Agent",
    "copyright": "Copyright © 2026 AIDA",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AIDA Agent, telefon görüşmelerinde sesinizi karşı tarafa iletebilmek için mikrofon erişimine ihtiyaç duyar.",
        "NSCameraUsageDescription": "AIDA Agent medya aygıtlarını listelemek için izin talep edebilir.",
        "NSAudioCaptureUsageDescription": "AIDA Agent sesli görüşmeler için ses giriş aygıtlarını kullanır."
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIDA Agent"
    }
  }
}
