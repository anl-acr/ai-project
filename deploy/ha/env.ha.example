# ==============================================================================
# Nornia HA Editions Environment Template (Spark • Midgard • Odin)
# Copy to /opt/ai-project/deploy/ha/.env or let install_nornia_*.sh generate it!
# ==============================================================================
NORNIA_EDITION=spark
NORNIA_VERSION=3.12.0
NORNIA_DOMAIN=pbx.firma.com
PUBLIC_IP=203.0.113.10
NORNIA_CERTS_DIR=/etc/nornia/certs

# PostgreSQL
POSTGRES_USER=pbx_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASS
POSTGRES_DB=ai_pbx

# Redis Cluster Bus
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASS

# MinIO / S3 Object Storage (Ses Kayıtları)
MINIO_ROOT_USER=nornia_s3
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASS
S3_BUCKET=nornia-recordings

# Asterisk AMI & Internal Security Secrets
AMI_USER=ai_backend_user
AMI_SECRET=CHANGE_ME_AMI_SECRET
NORNIA_SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
NORNIA_INTERNAL_API_TOKEN=CHANGE_ME_64_HEX_CHARS

# Optional: Odin Multi-Server / Geo-DR Endpoints
# ASTERISK_NODES=10.10.30.11:5038,10.10.30.12:5038
# NORNIA_API_INTERNAL_URL=http://10.10.20.10:8000
# NORNIA_AUDIOSOCKET_INTERNAL_ADDR=10.10.20.10:9092
# NORNIA_FEDERATION_HQ_BACKUP_URLS=https://dr-hq.firma.com
